# Advanced environment-name proposal, never real values.
# The documentation role does not write environment or deployment configuration.
# Confirm actual names from the application code; all names below are illustrative.
# Doppler owns server secrets, isolated by local, preview and production environment.
# Never expose database, WorkOS, R2, Stripe or Resend credentials through PUBLIC_
# or VITE_ variables, browser load data, source examples or logs.
PUBLIC_APP_ORIGIN=https://example.invalid
# Server names, only for capabilities the accepted project uses:
DATABASE_URL=replace-me-server-only
WORKOS_API_KEY=replace-me-server-only
WORKOS_CLIENT_ID=replace-me-client-identifier
WORKOS_COOKIE_PASSWORD=replace-me-server-only
R2_ACCESS_KEY_ID=replace-me-server-only
R2_SECRET_ACCESS_KEY=replace-me-server-only
R2_ENDPOINT=https://example.invalid
R2_BUCKET=replace-me-bucket-name
RESEND_API_KEY=replace-me-server-only
# Payload runs on its own Next.js host with built-in editor authentication.
# Its database/schema and migration owner remain separate from business tables.
PAYLOAD_SECRET=replace-me-server-only
# Optional custom Stripe checkout, disabled unless requested:
STRIPE_SECRET_KEY=replace-me-server-only
STRIPE_WEBHOOK_SECRET=replace-me-server-only
# No connection string or real account identifier is seeded here.
